# ============================================================
# INTELLIGENT LAND RECORD DIGITIZATION & VALIDATION SYSTEM
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────
APP_NAME="Land Record System"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT / Security ───────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=land_user
POSTGRES_PASSWORD=land_password
POSTGRES_DB=land_records_db
DATABASE_URL=postgresql+asyncpg://land_user:land_password@localhost:5432/land_records_db

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=land_audit_db

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# ── File Storage ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
